# ============================================================================
#  HueVista backend — environment variables
#  Copy to `.env` (or set these in your host/orchestrator) for production.
#  The app reads them via ${VAR} placeholders in application.properties.
#
#  For LOCAL dev you don't need ANY of this — run with the `dev` profile:
#     ./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
#  Schema is managed by Hibernate ddl-auto=update (no Flyway).
#
#  Grouped by priority:
#    [REQUIRED] the app won't run / shouldn't go to prod without these
#    [CORE]     powers the main product (AI paint visualizer + image storage)
#    [OPTIONAL] feature-gated add-ons — leave blank and that feature stays off
# ============================================================================


# ============================================================================
#  [REQUIRED]  — set these before any production deploy
# ============================================================================

# Self-generated, NOT a third-party key. Base64, 32+ bytes. No default anywhere.
#   Generate: openssl rand -base64 32
JWT_SECRET=

# PostgreSQL password (host/db/user are fixed in application.properties:
#   jdbc:postgresql://localhost:5432/huevista, user "postgres").
DB_PASSWORD=

# Public URL of THIS backend — used for share links.
APP_BASE_URL=https://api.your-domain.com
# Comma-separated list of allowed frontend origins (CORS).
CORS_ALLOWED_ORIGINS=https://app.your-domain.com

# Admin bootstrap: on startup, a single ROLE_ADMIN with these credentials is
# seeded IF both are set and no such account exists. The admin provisions every
# shop account — without one the platform can't be operated. Change the password
# after first sign-in.
#
# This is a LOGIN IDENTITY, not a shared inbox. Shop-lead notifications go to
# LEADS_EMAIL below; the two used to be the same value, which forced the admin
# console credentials to be a mailbox several people could read.
ADMIN_EMAIL=admin@huevista.org
ADMIN_PASSWORD=

# Where "request a shop account" submissions from the public /trial form land.
# A shared inbox the sales side reads. Falls back to ADMIN_EMAIL when blank.
LEADS_EMAIL=leads@huevista.org

# Where "the AI got this wrong" reports from the studio are announced — a clean that
# never came back, walls that landed in the wrong places. Every report also lands in
# the admin console (Mask reports) regardless of this; the mail is the nudge so
# nobody has to poll the queue. Falls back to ADMIN_EMAIL when blank.
SUPPORT_EMAIL=support@huevista.org


# ============================================================================
#  [CORE]  — the main product features
# ============================================================================

# --- Anthropic / Claude  (REQUIRED for the AI product) -----------------------
# Powers image classification, shade enrichment, color recommendations and the
# support agent. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- AWS S3  (image/mask storage) --------------------------------------------
# Blank bucket = store on the local filesystem instead (UPLOAD_PATH below).
# Credentials come from the instance IAM role (no access keys needed here).
S3_BUCKET_NAME=
S3_REGION=ap-south-1
UPLOAD_PATH=/var/huevista/uploads   # local storage path when S3 is unset

# --- Redis  (cache + async wall-segmentation queue) --------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Replicate  (auto wall-segmentation + image cleaner) ---------------------
# OFF unless enabled; when off, the UI falls back to manual click-to-segment.
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_NANO_BANANA_ENABLED=false
REPLICATE_IMAGE_CLEANER_ENABLED=false
# Cleaner generation resolution (Nano Banana Pro: 1K/2K/4K; blank to omit) and the
# local longest-edge upscale target in px (3840 ≈ 4K; 0 to disable upscaling).
REPLICATE_IMAGE_CLEANER_RESOLUTION=1K
REPLICATE_IMAGE_CLEANER_UPSCALE_PX=3840
# The models tried, in order, after REPLICATE_IMAGE_CLEANER_MODEL (Nano Banana 2)
# can't serve the clean. Wall detection runs ONLY on a cleaned canvas, so a clean
# nobody serves fails the whole run — hence a chain rather than one model.
#
# Grouped by family: the other Gemini tier first, then both FLUX tiers. Gemini leads
# because the MASK stage runs on Gemini too, so the canvas and the masks drawn over
# it normally come from the same family; FLUX is the independent pool behind it.
#
# Leave blank to turn the extra fallbacks off — which leaves a single model between a
# photo and a run that cannot happen, so do it only deliberately. Newer tiers
# (seedream-4-5, gpt-image-1-mini, flux-kontext-pro) can be listed here as-is — the
# request schema is picked from the model name. Note that openai/* models are SKIPPED
# unless OPENAI_API_KEY is set.
REPLICATE_IMAGE_CLEANER_FALLBACK_MODELS=google/nano-banana-pro,black-forest-labs/flux-2-pro,black-forest-labs/flux-2-max
# The models an ADMIN can pin ONE run to from the studio's testing panel — the clean
# and wall detection are chosen separately, so the same photo can be run through two
# models and compared. This is also the allow-list the segment endpoint validates
# against, so nothing outside it ever reaches Replicate. Comma-separated,
# "owner/model" or "owner/model|Human label". Blank = the built-in list (Nano Banana
# Pro / 2 / 1, FLUX 2 Max, FLUX 2 Pro, FLUX.1 Kontext Max, GPT Image 1, Seedream 4).
REPLICATE_SELECTABLE_MODELS=

# --- OpenAI  (only for openai/* models in the cleaner fallback chain) --------
# Replicate's openai/gpt-image-1 is a wrapper around OpenAI's own API and bills THIS
# key's account, so Replicate requires it in the request. Blank = GPT Image is
# skipped in the chain above and the next model is asked instead.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Google Gemini  (direct route for the image cleaner) ---------------------
# The same model as google/nano-banana-pro without Replicate's queue in front of it,
# tried when Replicate answers "no capacity" (E003). Blank = that route is off.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TESTING ONLY — keep false in production. Runs the full pipeline with the two
# paid image-model steps stubbed out: the photo is NOT cleaned (it stays the
# project canvas untouched) and the colour-coded mask is drawn locally as three
# vertical stripes, RED | GREEN | BLUE, giving you main wall + accent wall +
# trim regions on every upload. No REPLICATE_API_TOKEN needed for that path.
# Claude still classifies each upload for real (indoor / house exterior / not a
# house), so that check keeps working as in production.
HUEVISTA_TESTING_STUB_AI_ENABLED=false


# ============================================================================
#  [OPTIONAL]  — feature-gated add-ons (blank = that feature is disabled)
# ============================================================================

# --- Google OAuth2  ("Continue with Google" login) ---------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Razorpay  (subscriptions + one-time project credits) --------------------
# Step-by-step setup (test keys, plans, webhook, go-live): docs/RAZORPAY_SETUP.md
# Keys: https://dashboard.razorpay.com/app/keys  (rzp_test_* in Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Your own random string, set identically on the dashboard webhook. Blank = every
# webhook is rejected (fail-closed), so renewals/cancellations/refunds stop working.
RAZORPAY_WEBHOOK_SECRET=
# Dashboard → Subscriptions → Plans. Monthly, amounts must match Plan.java:
# Starter 99900 / Professional 249900 / Business 499900 paise. Test-mode plan IDs
# do NOT work in live mode — create them again after activation.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PROFESSIONAL=
RAZORPAY_PLAN_BUSINESS=
# How long a project bought with points stays workable.
PROJECT_CREDIT_VALID_DAYS=30
PROJECT_CREDIT_CURRENCY=INR

# --- In-store kiosk + shop reward points -------------------------------------
# One flat platform price per kiosk visualisation, entirely HueVista's; the shop
# earns closed-loop points instead of a share. Point prices and expiry are the
# app.points.* keys in application.properties.
STORE_PRICE_PAISE=9900
STORE_BONUS_POINTS=30
# How long the code a walk-in buys lasts. The kiosk link itself is permanent — the shop
# configures nothing on it and only pauses or deletes it — so this is a platform number,
# not a per-link choice. The walk-in re-enters this code at /unlock to pick their room
# back up at home, so it has to outlive the trip.
STORE_CODE_VALID_DAYS=3

# --- Points (the only balance; see application.properties for the price list) ---
# Buying: one rupee, one point. Everything chargeable besides a plan is paid in points,
# so there is no prepaid rupee wallet and no per-item cash checkout.
POINTS_RUPEES_PER_POINT=1
POINTS_MIN_PURCHASE=100
POINTS_MAX_PURCHASE=100000
POINTS_VALIDITY_DAYS=365

# --- AI image credits (the second wallet) ------------------------------------
# One credit is one photorealistic AI image. Unlike points these are held by whoever
# wants the picture — a shop OR a customer — because a project a shop gives away
# includes no AI image, and a customer account can hold no points and buy no plan.
#
# A LIST price plus a discount percentage, not two prices: two prices drift, and the
# strike-through the buyer is shown then stops being true. Launch = Rs. 198 less 50%
# = Rs. 99, matching the per-project top-up so nobody loses by topping up in advance.
# Set the discount to 0 to end the offer.
AI_CREDIT_LIST_PRICE_PAISE=19800
AI_CREDIT_LAUNCH_DISCOUNT_PERCENT=50
AI_CREDIT_MIN_PURCHASE=1
AI_CREDIT_MAX_PURCHASE=50
AI_CREDIT_RENDER_COST=1

# --- Email  (verification + password-reset codes) ----------------------------
# Blank host = codes are logged to the console instead of emailed.
# NOTE: MAIL_ENABLED / SMS_ENABLED also drive the retailer verification gate —
# a channel is only REQUIRED-verified before project creation when it can
# actually deliver a code. Production should enable MAIL_ENABLED; SMS_ENABLED
# has no delivery provider behind it (see the SMS section below).
#
# SENDERS: the SMTP account must be authorised to send as EVERY From address below,
# and they must all sit on one authenticated domain — a provider asked to send as an
# address it cannot authenticate rewrites the From or drops the message. Set SPF,
# DKIM and DMARC on that domain once and all of them are covered.
#
# HOST: pick one. The senders below are @huevista.org, so the relay must be able to
# authenticate that domain — this is the part that usually goes wrong.
#
#   Amazon SES (recommended here — the stack already runs in ap-south-1):
#     verify huevista.org + enable DKIM in SES, leave the sandbox, then create
#     SMTP credentials (these are SES-specific, NOT your AWS access keys).
#       MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
#       MAIL_USERNAME=<SES SMTP username>   MAIL_PASSWORD=<SES SMTP password>
#     Keeps no-reply@ / payments@huevista.org working as real senders.
#
#   Gmail, personal or unmanaged account:
#       MAIL_HOST=smtp.gmail.com  MAIL_USERNAME=<you>@gmail.com
#       MAIL_PASSWORD=<16-char app password, requires 2-Step Verification>
#     Gmail will REWRITE the From to the authenticated @gmail.com address unless the
#     sender is a verified "Send mail as" alias, so set MAIL_FROM to that address.
#
#   Google Workspace relay (smtp-relay.gmail.com): MANAGED Workspace accounts only.
#     Also requires this host's public egress IP to be registered under Admin console
#     → Apps → Google Workspace → Gmail → Routing → SMTP relay service. A personal or
#     unmanaged account here fails every send with "550-5.7.0 Mail relay denied ...
#     SMTP relay isn't supported for unmanaged work accounts" — note the app starts
#     up perfectly first, so the failure only shows on the first code that is sent.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Transactional sender: verification codes, password resets, welcome mails, admin 2FA
# codes, customer/shop notifications, payout notices.
MAIL_FROM=no-reply@huevista.org
# Payment + subscription receipts and renewal notices.
MAIL_BILLING_FROM=payments@huevista.org

# --- SMS  (mobile verification codes) ----------------------------------------
# No SMS provider is implemented — codes are only written to the server log.
# Leave this false: turning it on gates retailers behind a code that is never
# delivered. Implement a provider in SmsSender before enabling.
SMS_ENABLED=false

# --- Hardening toggles -------------------------------------------------------
SWAGGER_ENABLED=false            # Swagger UI + /v3/api-docs are public; dev only
RATE_LIMIT_TRUST_FORWARDED=true  # set false if the backend port is exposed directly
                                 # (stops X-Forwarded-For spoofing of per-IP limits)

# --- Abuse limits (per-IP; sensible defaults, override only if needed) -------
RATE_LIMIT_IMAGE_UPLOAD_MAX=30   # uploads/hour — each triggers a paid Claude classification
RATE_LIMIT_LEAD_MAX=5            # shop-account requests/hour (public form anti-spam)
RATE_LIMIT_FREE_START_MAX=40     # gallery rooms opened/hour — free, so nothing else caps it

# --- Monitoring (Prometheus) --------------------------------------------------
# Expose /actuator/prometheus (JVM, HTTP, Hikari, cache metrics) and open it to
# anonymous scrapes. ONLY do this when the backend port is private-network-only.
ACTUATOR_EXPOSURE=health         # set to: health,prometheus
METRICS_PUBLIC=false             # set true so the scraper can reach it without a JWT

# --- Timezone ------------------------------------------------------------------
# Timestamps are stored zone-naive (LocalDateTime) and the product is India-only.
# Keep the JVM on IST (the Docker image pins this) or every expiry shifts.
TZ=Asia/Kolkata
